# ==========================================
# Application
# ==========================================

APP_NAME=AI Software Engineer Assistant
APP_ENV=development
APP_HOST=127.0.0.1
APP_PORT=8000

# ==========================================
# Security
# ==========================================

SECRET_KEY=your-secret-key
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# ==========================================
# PostgreSQL Database
# ==========================================

DB_HOST=localhost
DB_PORT=5432
DB_NAME=ai_engineer_assistant
DB_USER=postgres
DB_PASSWORD=your-password

# ==========================================
# OpenAI
# ==========================================

GEMINI_API_KEY=your_gemini_api_key_here

# ==========================================
# Qdrant
# ==========================================

QDRANT_HOST=localhost
QDRANT_PORT=6333

# ==========================================
# Upload Settings
# ==========================================

MAX_UPLOAD_SIZE=100MB
UPLOAD_DIRECTORY=uploads